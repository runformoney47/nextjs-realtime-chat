# Copy to mobile/.env — restart Expo: npx expo start -c

EXPO_PUBLIC_PUSHER_APP_KEY=your_pusher_key
EXPO_PUBLIC_PUSHER_CLUSTER=us2

# Physical device / Expo Go: set your Mac's LAN IP (same Wi‑Fi or phone hotspot)
# macOS: ipconfig getifaddr en0   OR   npm run dev:lan-ip
EXPO_PUBLIC_API_URL=http://192.168.1.42:3001/api
