{
  "name": "groupchat-app",
  "private": true,
  "workspaces": [
    "packages/*",
    "server",
    "mobile"
  ],
  "scripts": {
    "dev:server": "npm run dev --workspace=server",
    "dev:mobile": "npm run start --workspace=mobile",
    "build:server": "npm run build --workspace=server",
    "build:shared": "npm run build --workspace=@groupchat/shared"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "react-native-worklets": "^0.7.3"
  }
}
